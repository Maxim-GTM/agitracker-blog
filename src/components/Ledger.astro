---
/**
 * The index: every post as one row, grouped by year. With `filterable`,
 * readers can narrow it by topic or by typing (no framework, ~1 KB of JS).
 */
import TagChip from './TagChip.astro';
import { collectTags, formatDay, postUrl, readingTime, tagSlug, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  filterable?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { posts, filterable = false, headingLevel: H = 'h3' } = Astro.props;

const years = new Map<number, Post[]>();
for (const post of posts) {
  const y = post.data.pubDate.getUTCFullYear();
  years.set(y, [...(years.get(y) ?? []), post]);
}
const tags = collectTags(posts);
---

<div class="ledger" data-ledger>
  {
    filterable && (
      <div class="ledger-controls">
        <label class="search cut cut--sm">
          <span class="sr-only">Search articles</span>
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="2.5" d="M8.5 3a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11Zm4 9.5L17 17" />
          </svg>
          <input type="search" placeholder="Search by title or topic" data-ledger-search autocomplete="off" />
        </label>
        <div class="topic-filter" role="group" aria-label="Filter by topic">
          <button type="button" class="chip cut fill-paper" aria-pressed="true" data-topic="">
            All <span class="chip-count">{posts.length}</span>
          </button>
          {tags.map((t) => (
            <button type="button" class="chip cut fill-paper" aria-pressed="false" data-topic={t.slug}>
              {t.name} <span class="chip-count">{t.count}</span>
            </button>
          ))}
        </div>
      </div>
    )
  }

  {
    [...years].map(([year, items]) => (
      <section class="ledger-year" data-ledger-group aria-labelledby={`y-${year}`}>
        <H class="ledger-yearlabel" id={`y-${year}`}>
          {year}
        </H>
        <ol class="ledger-rows" role="list">
          {items.map((post) => (
            <li
              class="ledger-row"
              data-ledger-row
              data-topics={post.data.tags.map(tagSlug).join(' ')}
              data-text={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}
            >
              <a href={postUrl(post)}>
                <time datetime={post.data.pubDate.toISOString()}>{formatDay(post.data.pubDate)}</time>
                <span class="ledger-main">
                  <span class="ledger-title">{post.data.title}</span>
                  <span class="ledger-desc">{post.data.description}</span>
                </span>
                <span class="ledger-tags">
                  {post.data.tags.slice(0, 2).map((t) => (
                    <TagChip tag={t} static />
                  ))}
                </span>
                <span class="ledger-time">{readingTime(post.body).minutes} min</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  {
    filterable && (
      <div class="ledger-empty cut fill-sun" data-ledger-empty hidden>
        <p>No articles match that search.</p>
        <button type="button" class="btn btn--sm cut cut--sm press fill-paper" data-ledger-reset>
          Clear filters
        </button>
      </div>
    )
  }
  {filterable && <p class="sr-only" aria-live="polite" data-ledger-status />}
</div>

{
  filterable && (
    <script>
      for (const root of document.querySelectorAll<HTMLElement>('[data-ledger]')) {
        const search = root.querySelector<HTMLInputElement>('[data-ledger-search]');
        const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-topic]')];
        const rows = [...root.querySelectorAll<HTMLElement>('[data-ledger-row]')];
        const groups = [...root.querySelectorAll<HTMLElement>('[data-ledger-group]')];
        const empty = root.querySelector<HTMLElement>('[data-ledger-empty]');
        const status = root.querySelector<HTMLElement>('[data-ledger-status]');
        let topic = '';

        const apply = () => {
          const q = (search?.value ?? '').trim().toLowerCase();
          let shown = 0;
          for (const row of rows) {
            const ok =
              (!topic || (row.dataset.topics ?? '').split(' ').includes(topic)) &&
              (!q || (row.dataset.text ?? '').includes(q));
            row.hidden = !ok;
            if (ok) shown++;
          }
          for (const g of groups) g.hidden = !g.querySelector('[data-ledger-row]:not([hidden])');
          if (empty) empty.hidden = shown > 0;
          if (status) status.textContent = `${shown} article${shown === 1 ? '' : 's'} shown`;
        };

        for (const b of buttons) {
          b.addEventListener('click', () => {
            topic = b.dataset.topic ?? '';
            for (const other of buttons) other.setAttribute('aria-pressed', String(other === b));
            apply();
          });
        }
        search?.addEventListener('input', apply);
        root.querySelector('[data-ledger-reset]')?.addEventListener('click', () => {
          if (search) search.value = '';
          buttons[0]?.click();
        });

        const q = new URLSearchParams(location.search).get('q');
        if (q && search) {
          search.value = q;
          apply();
        }
      }
    </script>
  )
}

<style>
  .ledger-controls {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-bottom: 2rem;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 1rem;
    max-width: 30rem;
    min-height: 3.1rem;
  }
  .search input {
    flex: 1;
    border: 0;
    background: transparent;
    font: inherit;
    padding: 0.6rem 0;
    min-width: 0;
  }
  .search input:focus {
    outline: none;
  }
  .search:focus-within {
    --fill: #fff;
    --sx: 5px;
    --sy: 5px;
  }
  .topic-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .topic-filter button {
    cursor: pointer;
    border: 0;
    background: none;
    font-size: 0.9rem;
    padding: 0.35rem 0.85rem;
  }
  .topic-filter button:hover {
    --fill: var(--signal);
  }
  .topic-filter button[aria-pressed='true'] {
    --fill: var(--ink);
    color: var(--paper);
    --sx: 0px;
    --sy: 0px;
    transform: translate(2px, 2px);
  }

  .ledger-year {
    display: grid;
    grid-template-columns: 7rem 1fr;
    border-top: var(--bw) solid var(--ink);
  }
  .ledger-year:last-of-type {
    border-bottom: var(--bw) solid var(--ink);
  }
  .ledger-yearlabel {
    font-size: var(--step-3);
    font-weight: 800;
    padding-top: 0.9rem;
    color: var(--ink);
    -webkit-text-stroke: 0;
  }
  .ledger-rows {
    border-left: var(--bw) solid var(--ink);
  }
  .ledger-row + .ledger-row {
    border-top: 2px dashed rgb(0 0 0 / 0.35);
  }
  .ledger-row a {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto 4rem;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1rem 1.25rem;
    text-decoration: none;
    background: var(--paper);
    transition: background-color 100ms ease;
  }
  .ledger-row a:hover {
    background: var(--signal);
  }
  .ledger-row a:hover .ledger-title {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }
  .ledger-row time,
  .ledger-time {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .ledger-time {
    text-align: right;
    color: var(--muted);
  }
  .ledger-main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .ledger-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .ledger-desc {
    color: #3a362f;
    font-size: 0.98rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ledger-tags {
    display: flex;
    gap: 0.45rem;
    align-self: center;
  }
  .ledger-empty {
    margin-top: 2rem;
    padding: 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    font-weight: 700;
  }
  [hidden] {
    display: none !important;
  }

  @media (max-width: 900px) {
    .ledger-row a {
      grid-template-columns: 4rem minmax(0, 1fr) 3.5rem;
    }
    .ledger-tags {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .ledger-year {
      grid-template-columns: 1fr;
    }
    .ledger-yearlabel {
      padding-block: 0.6rem;
    }
    .ledger-rows {
      border-left: 0;
      border-top: var(--bw) solid var(--ink);
    }
    .ledger-row a {
      grid-template-columns: 1fr auto;
      gap: 0.3rem 1rem;
      padding: 0.9rem 1rem;
    }
    .ledger-main {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .ledger-desc {
      display: none;
    }
  }
</style>
