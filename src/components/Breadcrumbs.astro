---
interface Props {
  items: { name: string; url: string }[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol role="list">
    {
      items.map((item, i) =>
        i === items.length - 1 ? (
          <li aria-current="page">{item.name}</li>
        ) : (
          <li>
            <a href={item.url}>{item.name}</a>
          </li>
        ),
      )
    }
  </ol>
</nav>
