---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const headings = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  headings.length > 1 && (
    <nav class="toc" aria-labelledby="toc-title" data-toc>
      <details open>
        <summary id="toc-title">On this page</summary>
        <ol role="list">
          {headings.map((h) => (
            <li class={`toc-d${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

<script>
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const details = toc.querySelector('details');
    if (details && matchMedia('(max-width: 1080px)').matches) details.open = false;
    const links = new Map(
      [...toc.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]),
    );
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          for (const a of links.values()) a.removeAttribute('aria-current');
          links.get(e.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    for (const id of links.keys()) {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    }
  }
</script>

<style>
  .toc summary {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-0);
    cursor: pointer;
    padding: 0.8rem 1rem;
    background: var(--ink);
    color: var(--paper);
    list-style: none;
    display: flex;
    justify-content: space-between;
  }
  .toc summary::-webkit-details-marker {
    display: none;
  }
  .toc summary::after {
    content: '+';
    color: var(--signal);
  }
  .toc details[open] summary::after {
    content: '\2212';
  }
  .toc details {
    border: var(--bw) solid var(--ink);
    background: var(--paper);
    box-shadow: 5px 5px 0 var(--ink);
  }
  .toc ol {
    padding: 0.6rem 0;
    max-height: calc(100vh - 10rem);
    overflow-y: auto;
  }
  .toc a {
    display: block;
    padding: 0.35rem 1rem;
    font-size: 0.93rem;
    line-height: 1.35;
    text-decoration: none;
    border-left: 5px solid transparent;
  }
  .toc .toc-d3 a {
    padding-left: 2rem;
    font-size: 0.88rem;
    color: #3a362f;
  }
  .toc a:hover {
    background: var(--ground);
  }
  .toc a[aria-current] {
    border-left-color: var(--ink);
    background: var(--signal);
    font-weight: 700;
    color: var(--ink);
  }
</style>
