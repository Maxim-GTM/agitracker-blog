---
import { Image } from 'astro:assets';
import icon from '../assets/brand/icon.png';
import wordmark from '../assets/brand/title.png';
import { NAV } from '../site.config';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (path === href || path.startsWith(href) ? 'page' : undefined);
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="agitracker.io home">
      <Image class="brand-icon" src={icon} width={52} densities={[1, 2]} alt="" loading="eager" fetchpriority="high" />
      <Image class="brand-title" src={wordmark} width={172} densities={[1, 2]} alt="agitracker.io" loading="eager" fetchpriority="high" />
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul role="list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="nav-rss" href="/rss.xml" title="Subscribe with RSS">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M2 2v2.2A9.8 9.8 0 0 1 11.8 14H14A12 12 0 0 0 2 2Zm0 4.4v2.2A5.4 5.4 0 0 1 7.4 14h2.2A7.6 7.6 0 0 0 2 6.4ZM3.6 11A1.6 1.6 0 1 0 3.6 14.2 1.6 1.6 0 0 0 3.6 11Z" /></svg>
            <span class="nav-rss-label">RSS</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
