---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, postUrl } from '../lib/posts';

const latest = (await getPosts()).slice(0, 4);
---

<BaseLayout title="Page not found" description="This page doesn't exist. Try the latest articles instead." noindex>
  <section class="nf wrap">
    <p class="nf-code cut fill-sun" aria-hidden="true">404</p>
    <h1>This page isn’t on the tracker.</h1>
    <p class="nf-lede">The link may be old or mistyped. Start from the home page, or pick one of the latest articles.</p>
    <div class="nf-actions">
      <a class="btn cut press fill-signal" href="/">Go to the home page</a>
      <a class="btn cut press fill-paper" href="/blog/">Browse all articles</a>
    </div>
    {
      latest.length > 0 && (
        <ul class="nf-list" role="list">
          {latest.map((p) => (
            <li>
              <a href={postUrl(p)}>{p.data.title}</a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(3rem, 8vw, 6rem) 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .nf-code {
    --c: 26px;
    --sx: 10px;
    --sy: 10px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 9rem);
    line-height: 1;
    padding: 1.5rem 2.5rem;
    rotate: -3deg;
  }
  .nf h1 {
    font-size: var(--step-4);
    font-weight: 800;
    max-width: 18ch;
  }
  .nf-lede {
    font-size: var(--step-1);
    max-width: 44ch;
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
  }
  .nf-list {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
  }
  .nf-list a {
    text-decoration-color: var(--signal-deep);
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }
</style>
